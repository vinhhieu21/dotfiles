{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SKIP_PLUGIN_MCP_SERVERS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/usage-band"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git stash list*)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(fd*)",
      "Bash(tree*)",
      "Bash(jq*)",
      "Bash(yq*)",
      "Bash(which*)",
      "Bash(echo*)",
      "Bash(printenv*)",
      "Bash(go version)",
      "Bash(go vet*)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(go mod tidy)",
      "Bash(java -version)",
      "Bash(./mvnw*)",
      "Bash(./gradlew*)",
      "Bash(mvn -v)",
      "Bash(gradle -v)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(pytest*)",
      "Bash(pip list*)",
      "Bash(uv*)",
      "Bash(node --version)",
      "Bash(npm test*)",
      "Bash(pnpm*)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker logs*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh api*)",
      "Bash(tmux:*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:docs.python.org)"
    ],
    "deny": [
      "Artifact",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin master*)",
      "Bash(git push -f origin main*)",
      "Bash(git push -f origin master*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "ScheduleWakeup",
      "Workflow"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Live-trading execution commands (anything placing real orders on an exchange) - real funds are at risk"
    ]
  }
}
